# ---------------------------------------------------------------------------
# VYBZ configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# HTTP port the server listens on
PORT=3000

# Public base URL (used for links, CORS origin checks, WebSocket origin checks)
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: durable local SQLite file via Node's built-in `node:sqlite`.
# No credentials required, survives restarts.
DATABASE_FILE=./data/vybz.db

# Optional: PostgreSQL / Neon connection string. When set, the server keeps
# using SQLite for development unless the postgres adapter is enabled.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DB_DRIVER=sqlite

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to pepper session tokens. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in days
SESSION_DAYS=30
# Bootstrap admin: the first account created with this username becomes admin.
BOOTSTRAP_ADMIN_USERNAME=admin

# ---------------------------------------------------------------------------
# Automated judging (optional). Without these the game uses a documented
# deterministic heuristic rubric and labels scores accordingly.
# ---------------------------------------------------------------------------
# AI_JUDGE_ENABLED=true
# AI_JUDGE_PROVIDER=openai
# AI_JUDGE_MODEL=gpt-4o-mini
# AI_JUDGE_API_KEY=
# AI_JUDGE_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Media storage (optional). Without it, avatars are validated and stored
# in the database (bounded size) and preset avatars are always available.
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Rate limiting (requests per window)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
